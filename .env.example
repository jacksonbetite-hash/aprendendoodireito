# Copie para .env e ajuste. O docker compose lê este arquivo automaticamente.
# Em produção, nunca versione o .env preenchido.

# ---- Identidade da pilha ----
# O compose derivaria o nome do projeto da pasta; fixar aqui garante que
# containers e volumes continuem `aprimoreosaber_*` mesmo se a pasta for
# clonada com outro nome.
COMPOSE_PROJECT_NAME=aprimoreosaber

# ---- Banco ----
# Senha do PostgreSQL. Troque antes de expor o sistema a qualquer rede.
POSTGRES_PASSWORD=aprimore

# ---- Aplicação ----
# Porta em que o site responde na sua máquina.
# Porta do PostgreSQL na sua maquina (so para conectar de fora do Docker).
PORTA_BANCO=5432

PORTA_WEB=3000

# ---- Pagamento (§8) ----
# `simulado` roda sem credencial e não cobra nada — é o padrão para
# instalação local. Ao integrar Asaas ou Pagar.me (§8.2), troque aqui.
PROVEDOR_PAGAMENTO=simulado

# Segredo que valida a assinatura do webhook do gateway. Gere um valor
# próprio antes de qualquer ambiente acessível de fora:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SEGREDO=segredo-de-desenvolvimento

# ---- Vídeo das aulas (§10) ----
# Assina os endereços de vídeo. Sem ele o link da aula seria público e a
# licença de §6.3 não valeria nada. Em produção o sistema RECUSA subir sem
# este valor — gere um próprio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar o segredo invalida os endereços já entregues: quem estava
# assistindo recarrega a página e segue. É assim que se corta um vazamento.
VIDEO_SEGREDO=

# Onde os arquivos moram. Localmente é uma pasta do projeto (fora do git);
# no Compose é o volume `midia`, montado em /midia.
VIDEO_RAIZ=./midia/video

# Vazio = o próprio Node entrega os bytes. Serve para desenvolvimento e
# para pouca gente simultânea.
# Com nginx na frente (docker-compose), use a location interna:
#   VIDEO_ACCEL_REDIRECT=/midia-interna
# Aí o Node só autoriza e o nginx transporta com sendfile() — centenas de
# MB deixam de atravessar o event loop.
VIDEO_ACCEL_REDIRECT=

# ---- Portais de professor (§5.10) ----
# Domínio sob o qual os portais vivem. `jackson.aprimoreosaber.com.br`
# resolve o portal do Jackson; o domínio nu é a plataforma. Em
# desenvolvimento deixe `localhost` — `jackson.localhost:3010` funciona no
# navegador sem configurar DNS nem arquivo de hosts.
DOMINIO_BASE=localhost

# ---- Desenvolvimento ----
# Resolve a sessão por e-mail fixo quando não há cookie. Ignorado em
# produção (NODE_ENV=production). Deixe vazio para exigir login sempre.
ALUNO_DEMO=
