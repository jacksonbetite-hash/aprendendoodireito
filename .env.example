# Copie para .env e ajuste. O docker compose lê este arquivo automaticamente.
# Em produção, nunca versione o .env preenchido.

# ---- Banco ----
# Senha do PostgreSQL. Troque antes de expor o sistema a qualquer rede.
POSTGRES_PASSWORD=aprendendo

# ---- Aplicação ----
# Porta em que o site responde na sua máquina.
PORTA_WEB=3000

# ---- Pagamento (§8) ----
# `simulado` roda sem credencial e não cobra nada — é o padrão para
# instalação local. Ao integrar Asaas ou Pagar.me (§8.2), troque aqui.
PROVEDOR_PAGAMENTO=simulado

# Segredo que valida a assinatura do webhook do gateway. Gere um valor
# próprio antes de qualquer ambiente acessível de fora:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SEGREDO=segredo-de-desenvolvimento

# ---- Desenvolvimento ----
# Resolve a sessão por e-mail fixo quando não há cookie. Ignorado em
# produção (NODE_ENV=production). Deixe vazio para exigir login sempre.
ALUNO_DEMO=
